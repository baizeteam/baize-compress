{
  "name": "baize-compress",
  "version": "1.0.1",
  "type": "module",
  "keywords": [
    "compress",
    "image",
    "audio",
    "video",
    "mediabunny",
    "webcodecs",
    "web-worker",
    "image-compression",
    "video-compression",
    "audio-compression",
    "mp3",
    "mp4",
    "webm",
    "jpeg",
    "png",
    "webp",
    "svg",
    "gif",
    "svgo",
    "gifsicle",
    "OffscreenCanvas",
    "upng-js"
  ],
  "files": [
    "dist",
    "index.d.ts",
    "plugins"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baizeteam/baize-compress"
  },
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins/jpeg-webp": {
      "types": "./plugins/jpeg-webp.d.ts",
      "import": "./dist/plugins/jpeg-webp.js"
    },
    "./plugins/png": {
      "types": "./plugins/png.d.ts",
      "import": "./dist/plugins/png.js"
    },
    "./plugins/svg": {
      "types": "./plugins/svg.d.ts",
      "import": "./dist/plugins/svg.js"
    },
    "./plugins/gif": {
      "types": "./plugins/gif.d.ts",
      "import": "./dist/plugins/gif.js"
    },
    "./plugins/media": {
      "types": "./plugins/media.d.ts",
      "import": "./dist/plugins/media.js"
    }
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "dev": "vite",
    "build:page": "tsc && cross-env BUILD_MODE=page vite build",
    "build": "tsc && cross-env BUILD_MODE=lib vite build && tsc -p tsconfig.declarations.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/upng-js": "^2.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^7.0.3",
    "gifsicle-wasm-browser": "1.5.19",
    "mediabunny": "^1.66.0",
    "oxfmt": "^0.78.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgo": "^4.0.1",
    "typescript": "^7.0.2",
    "upng-js": "^2.1.0",
    "vite": "^8.3.8"
  },
  "description": "基于插件和共用 Web Worker 池的图片、音频及视频压缩库。",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.33.4",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "LGPL-3.0-only"
}
